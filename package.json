{
  "name": "ffjavascript",
  "type": "module",
  "version": "0.3.1",
  "description": "Finite Field Library in Javascript",
  "main": "./build/main.cjs",
  "module": "./main.js",
  "exports": {
    ".": {
      "node": {
        "import": "./main.js",
        "require": "./build/main.cjs"
      },
      "browser": "./build/browser.esm.js"
    }
  },
  "browser": {
    "os": false,
    "crypto": false
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:node": "vitest run --project node-esm",
    "test:watch": "vitest --project node-esm",
    "test:ses": "node test/ses/lockdown.mjs",
    "gen-wasm": "node scripts/gen-wasm.js",
    "build:node": "vite build",
    "build:browser": "vite build --mode browser",
    "build": "npm run clean && npm run build:node && npm run build:browser"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/ffjavascript.git"
  },
  "keywords": [
    "Finite",
    "Field",
    "Javascript",
    "Snark",
    "Cryptography",
    "Library"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/iden3/ffjavascript/issues"
  },
  "homepage": "https://github.com/iden3/ffjavascript",
  "optionalDependencies": {
    "wasmbuilder": "0.0.16",
    "wasmcurves": "git+https://github.com/iden3/wasmcurves.git#13d4acc125b794a4e28a5dc1ea99f015d863ec98"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "binaryen": "^130.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "ses": "^2.2.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "postcss": "^8.5.26",
    "brace-expansion": "^5.0.9"
  }
}
