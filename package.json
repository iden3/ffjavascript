{
  "name": "@toruslabs/ffjavascript",
  "version": "6.0.0",
  "description": "Finite Field Library in Javascript",
  "main": "./dist/lib.cjs/index.js",
  "module": "./dist/lib.esm/index.js",
  "unpkg": "./dist/lib.esm/index.js",
  "jsdelivr": "./dist/lib.esm/index.js",
  "types": "./dist/lib.cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint --fix",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish",
    "prepack": "npm run build",
    "test": "npm run test:node && npm run test:browsers",
    "test:node": "vitest run --config test/configs/node.config.mts --coverage",
    "test:chrome": "vitest run --config test/configs/chrome.config.mts",
    "test:browsers": "npm run test:chrome"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/ffjavascript.git"
  },
  "keywords": [
    "Finite",
    "Field",
    "Javascript",
    "Snark",
    "Cryptography",
    "Library"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/MetaMask/ffjavascript/issues"
  },
  "homepage": "https://github.com/MetaMask/ffjs#readme",
  "devDependencies": {
    "@babel/runtime": "^7.28.6",
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "playwright": "^1.64.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": false,
    "fsevents@2.3.3": false
  }
}
